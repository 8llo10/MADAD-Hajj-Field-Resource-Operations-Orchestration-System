{
  "name": "madad-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c auto \"npm run dev -w @madad/api\" \"npm run dev -w @madad/web\"",
    "build": "npm run build -w @madad/api && npm run build -w @madad/web",
    "test": "npm run test -w @madad/api",
    "db:generate": "npm run db:generate -w @madad/api",
    "db:migrate": "npm run db:migrate -w @madad/api",
    "db:seed": "npm run db:seed -w @madad/api",
    "db:push": "npm run db:push -w @madad/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
