generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMMANDER
  DISPATCHER
  SUPERVISOR
  TECHNICIAN
  VIEWER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  TRIAGED
  ASSIGNED
  EN_ROUTE
  ON_SITE
  RESOLVED
  CLOSED
  CANCELLED
}

enum TeamStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
  MAINTENANCE
}

enum ResourceStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ResourceType {
  VEHICLE
  EQUIPMENT
  TOOL
  DEVICE
  SAFETY_KIT
  OTHER
}

enum DispatchStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  DISPATCHED
  ARRIVED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  CRITICAL
  ASSIGNMENT
  SLA
  SYSTEM
}

enum InventoryTxnType {
  RECEIPT
  ISSUE
  RETURN
  ADJUSTMENT
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  name             String
  role             Role             @default(VIEWER)
  phone            String?
  isActive         Boolean          @default(true)
  teamMemberships  TeamMember[]
  createdIncidents Incident[]       @relation("IncidentCreator")
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Site {
  id          String     @id @default(cuid())
  code        String     @unique
  nameAr      String
  nameEn      String
  latitude    Float
  longitude   Float
  criticality Int        @default(3)
  zones       Zone[]
  teams       Team[]
  resources   Resource[]
  incidents   Incident[]
  createdAt   DateTime   @default(now())
}

model Zone {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  siteId       String
  crowdDensity Int        @default(3)
  latitude     Float
  longitude    Float
  site         Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  incidents    Incident[]
  teams        Team[]

  @@index([siteId])
}

model Team {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  specialization    String
  status            TeamStatus   @default(AVAILABLE)
  siteId            String
  zoneId            String?
  latitude          Float
  longitude         Float
  activeJobs        Int          @default(0)
  maxConcurrentJobs Int          @default(2)
  skills            String[]
  site              Site         @relation(fields: [siteId], references: [id])
  zone              Zone?        @relation(fields: [zoneId], references: [id])
  members           TeamMember[]
  dispatches        Dispatch[]

  @@index([siteId, status])
}

model TeamMember {
  id     String  @id @default(cuid())
  teamId String
  userId String
  isLead Boolean @default(false)
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Resource {
  id               String          @id @default(cuid())
  assetTag         String          @unique
  name             String
  type             ResourceType
  status           ResourceStatus  @default(AVAILABLE)
  siteId           String
  latitude         Float?
  longitude        Float?
  capabilities     String[]
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  site             Site            @relation(fields: [siteId], references: [id])
  dispatchResources DispatchResource[]

  @@index([siteId, status])
}

model InventoryItem {
  id              String                 @id @default(cuid())
  sku             String                 @unique
  name            String
  category        String
  unit            String
  quantity        Int                    @default(0)
  reorderLevel    Int                    @default(5)
  storageLocation String
  transactions    InventoryTransaction[]
  updatedAt       DateTime               @updatedAt
}

model InventoryTransaction {
  id        String             @id @default(cuid())
  itemId    String
  type      InventoryTxnType
  quantity  Int
  reference String?
  notes     String?
  item      InventoryItem      @relation(fields: [itemId], references: [id])
  createdAt DateTime           @default(now())

  @@index([itemId, createdAt])
}

model Incident {
  id                           String             @id @default(cuid())
  reference                    String             @unique
  title                        String
  description                  String
  category                     String
  severity                     IncidentSeverity
  status                       IncidentStatus     @default(NEW)
  source                       String             @default("COMMAND_CENTER")
  siteId                       String
  zoneId                       String?
  latitude                     Float
  longitude                    Float
  reportedById                 String?
  peopleAffected               Int                @default(0)
  slaMinutes                   Int                @default(60)
  requiredSkills               String[]
  requiredCapabilities         String[]
  aiRiskScore                  Float?
  aiSlaBreachProbability       Float?
  aiEstimatedResolutionMinutes Int?
  aiSummary                    String?
  reportedAt                   DateTime           @default(now())
  triagedAt                    DateTime?
  resolvedAt                   DateTime?
  closedAt                     DateTime?
  site                         Site               @relation(fields: [siteId], references: [id])
  zone                         Zone?              @relation(fields: [zoneId], references: [id])
  reportedBy                   User?              @relation("IncidentCreator", fields: [reportedById], references: [id])
  dispatches                   Dispatch[]
  statusEvents                 IncidentStatusEvent[]

  @@index([status, severity, reportedAt])
  @@index([siteId, reportedAt])
}

model IncidentStatusEvent {
  id         String          @id @default(cuid())
  incidentId String
  fromStatus IncidentStatus?
  toStatus   IncidentStatus
  note       String?
  actorId    String?
  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@index([incidentId, createdAt])
}

model Dispatch {
  id           String         @id @default(cuid())
  incidentId   String
  teamId       String
  status       DispatchStatus @default(PROPOSED)
  score        Float
  distanceKm   Float
  etaMinutes   Int
  explanation  Json
  proposedAt   DateTime       @default(now())
  acceptedAt   DateTime?
  dispatchedAt DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  incident     Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  team         Team           @relation(fields: [teamId], references: [id])
  resources    DispatchResource[]

  @@index([incidentId, status])
  @@index([teamId, status])
}

model DispatchResource {
  id         String   @id @default(cuid())
  dispatchId String
  resourceId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id])

  @@unique([dispatchId, resourceId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  entityType String?
  entityId   String?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  actor      User?    @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
