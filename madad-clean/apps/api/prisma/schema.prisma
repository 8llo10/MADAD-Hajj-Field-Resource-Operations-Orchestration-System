generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { ADMIN COMMANDER DISPATCHER SUPERVISOR TECHNICIAN }
enum IncidentSeverity { LOW MEDIUM HIGH CRITICAL }
enum IncidentStatus { OPEN TRIAGED ASSIGNED EN_ROUTE ON_SITE RESOLVED CLOSED }
enum TeamStatus { AVAILABLE BUSY OFFLINE }
enum ResourceStatus { AVAILABLE IN_USE MAINTENANCE OFFLINE }
enum ResourceType { VEHICLE GENERATOR PUMP TOOL KIT OTHER }
enum DispatchStatus { PROPOSED ACCEPTED DISPATCHED ARRIVED COMPLETED CANCELLED }
enum InventoryTxnType { RECEIPT ISSUE RETURN ADJUSTMENT }

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  memberships TeamMember[]
  audits       AuditLog[] @relation("AuditActor")
  notifications Notification[]
}

model Site {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  latitude  Float
  longitude Float
  zones     Zone[]
  teams     Team[]
  resources Resource[]
  incidents Incident[]
}

model Zone {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  siteId    String
  site      Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  teams     Team[]
  incidents Incident[]
}

model Team {
  id                String     @id @default(cuid())
  code              String     @unique
  name              String
  specialization    String
  skills            String[]
  status            TeamStatus @default(AVAILABLE)
  siteId            String
  site              Site       @relation(fields: [siteId], references: [id])
  zoneId            String?
  zone              Zone?      @relation(fields: [zoneId], references: [id])
  latitude          Float
  longitude         Float
  activeJobs        Int        @default(0)
  maxConcurrentJobs Int        @default(2)
  members           TeamMember[]
  dispatches        Dispatch[]
  @@index([status, siteId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
}

model Incident {
  id              String           @id @default(cuid())
  code            String           @unique
  title           String
  description     String
  category        String
  requiredSkills  String[]
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  siteId          String
  site            Site             @relation(fields: [siteId], references: [id])
  zoneId          String?
  zone            Zone?            @relation(fields: [zoneId], references: [id])
  latitude        Float
  longitude       Float
  slaMinutes      Int
  openedAt        DateTime         @default(now())
  assignedAt      DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  dispatches      Dispatch[]
  statusEvents    IncidentStatusEvent[]
  @@index([status, severity])
}

model IncidentStatusEvent {
  id         String         @id @default(cuid())
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromStatus IncidentStatus?
  toStatus   IncidentStatus
  actorId    String?
  note       String?
  createdAt  DateTime       @default(now())
}

model Dispatch {
  id          String         @id @default(cuid())
  incidentId  String
  incident    Incident       @relation(fields: [incidentId], references: [id])
  teamId      String
  team        Team           @relation(fields: [teamId], references: [id])
  score       Float
  distanceKm  Float
  etaMinutes  Int
  explanation Json
  status      DispatchStatus @default(PROPOSED)
  proposedAt  DateTime       @default(now())
  acceptedAt  DateTime?
  dispatchedAt DateTime?
  arrivedAt   DateTime?
  completedAt DateTime?
  resources   DispatchResource[]
  @@index([incidentId, status])
}

model Resource {
  id           String         @id @default(cuid())
  assetTag     String         @unique
  name         String
  type         ResourceType
  status       ResourceStatus @default(AVAILABLE)
  siteId       String
  site         Site           @relation(fields: [siteId], references: [id])
  latitude     Float?
  longitude    Float?
  capabilities String[]
  dispatches   DispatchResource[]
}

model DispatchResource {
  id         String   @id @default(cuid())
  dispatchId String
  resourceId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id])
  @@unique([dispatchId, resourceId])
}

model InventoryItem {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  quantity       Int      @default(0)
  reorderLevel   Int      @default(0)
  unit           String
  transactions   InventoryTransaction[]
}

model InventoryTransaction {
  id        String           @id @default(cuid())
  itemId    String
  item      InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      InventoryTxnType
  quantity  Int
  reference String?
  notes     String?
  createdAt DateTime         @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entity     String
  entityId   String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())
}
